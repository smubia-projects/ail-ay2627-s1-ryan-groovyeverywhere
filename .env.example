# groovyeverywhere demo API (Hugging Face Space secrets; the AI Lodge deploy kit sets them from this project's .env).
# Read-only, fine-grained Hugging Face token for the private dataset that holds Ryan's demo bundle.
HF_DATA_TOKEN=
# The Vercel page's origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5500
# Shared AI Lodge rate limiter (Upstash Redis). Unset = no limit (local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Fallbacks; the central control sheet overrides them. One hit per analysed clip.
RATE_LIMIT_ANALYSE_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000
# Optional overrides of where the bundle comes from.
GROOVY_DATA_REPO=smubiainfrastructure/ail-ay2627-s1-ryan-groovyeverywhere-data
GROOVY_DATA_FILE=groovy-demo-bundle.zip
